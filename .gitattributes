# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Explicit text file types
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Binary files that should not undergo line-ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.pt binary
*.onnx binary
*.mp4 binary
